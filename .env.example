# Copiar a .env y ajustar. Nunca subir .env al repositorio.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_TIMEZONE=UTC

# Cookie Secure=false en HTTP local; true detras de HTTPS en produccion
SESSION_SECURE=false
SESSION_NAME=ies_web_session
SESSION_LIFETIME_MINUTES=120

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ies_web
DB_USER=ies_web
DB_PASSWORD=ies_web_secret
DB_ROOT_PASSWORD=root_secret

# Usuario admin del seed de desarrollo (cambiar siempre)
ADMIN_EMAIL=admin@iesramonarcas.local
ADMIN_PASSWORD=ChangeMe_DevOnly_123!
ADMIN_NAME=Administrador

# Origenes permitidos (same-origin en Docker)
CORS_ORIGINS=http://localhost:8088,http://localhost:5173

UPLOAD_MAX_BYTES=5242880
