{
  "name": "ies-ramon-arcas/web-api",
  "description": "API REST de la web publica del IES Ramon Arcas",
  "type": "project",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php bin/migrate.php",
    "seed": "php bin/seed.php"
  }
}
